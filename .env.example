# Edge-TTS API 环境变量配置文件模板
# 复制本文件为 .env 即可生效: cp .env.example .env

# 服务映射端口（宿主机）
PORT=36485

# API 鉴权 Token（建议修改为您自己的高强度随机秘钥，留空则免认证模式）
API_TOKEN=your_secure_api_token_here

# 输出文件保存目录
OUTPUT_DIR=/nasShare/edgeTTSoutputs

# 生成文件保留时长（小时，192小时 = 8天）
FILE_LIFETIME_HOURS=192

# 微软并发限制（防封控，推荐 1~2）
TTS_MAX_CONCURRENCY=1

# 失败重试次数
TTS_MAX_RETRIES=3

# 任务基础超时（秒，长文自动弹性放宽至15分钟）
TTS_TIMEOUT_SECONDS=300

# 流式数据静默假死超时（秒）
TTS_INACTIVITY_TIMEOUT=60

# 每次请求后的冷却微间隔（秒）
TTS_COOLDOWN_SECONDS=0.5

# 可选上游代理服务器（例如 http://127.0.0.1:7890）
# DEFAULT_PROXY=
